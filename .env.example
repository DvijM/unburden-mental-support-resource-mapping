# Unburden Environment Configuration
# Copy this file to .env and configure values. Never commit .env to version control.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# MongoDB Atlas or local MongoDB connection URI
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/unburden?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/unburden

# Cryptographic session secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_a_strong_64_character_hex_session_secret

# Initial Super-Admin Provisioning (idempotent: creates super_admin on first boot or via npm run create-admin)
INITIAL_ADMIN_EMAIL=admin@unburden.org
INITIAL_ADMIN_PASSWORD=change_this_admin_password_12345
INITIAL_ADMIN_NAME=Super Administrator

# Session lifetimes (hours)
USER_SESSION_HOURS=8
ADMIN_SESSION_HOURS=2

# Optional: External transactional email provider API key (for automated password-reset and invitation emails)
# EMAIL_PROVIDER_API_KEY=
