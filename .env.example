# Unburden Environment Configuration
# Copy this file to .env and configure values.

PORT=3000

# Local MongoDB connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/unburden

# Initial Administrator Credentials (used by scripts/create-admin.js)
ADMIN_EMAIL=admin@unburden.org
ADMIN_PASSWORD=change_this_admin_password_123

# Session lifetimes (hours)
USER_SESSION_HOURS=8
ADMIN_SESSION_HOURS=2
